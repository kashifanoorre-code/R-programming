rm(list=ls())
x=c(18,16,15,12)
y=c(770,785,790,800)
plot(x,y)   #Scatterplot
cov(x,y)    #Covariance
cor(x,y)    #Correlation

#Linear model:y=a+bx   Command: lm(y~x)
fit1=lm(y~x)
summary(fit1)
#Write the linear model. 
#Explain goodeness of fit. Look at multiple r sq.

#Fitted values : y.hat=a.hat+b.hat*x
fitted1=fit1$coefficients[1]+fit1$coefficients[2]*x
fitted2=fit1$fitted.values
fitted1;fitted2
predict(fit1)

#Find the estimate of y for x=17: y.hat=a.hat+b.hat*17
fit1$coefficients[1]+fit1$coefficients[2]*17

# Residuals: y-y.hat
res1=y-fitted1;res1
res2=fit1$residuals;res2
resid(fit1)
plot(predict(fit1),resid(fit1))
abline(h=0,col="red")

#Model without intercept
fit.var=lm(y~-1+x);summary(fit.var)
#Quadratic model
