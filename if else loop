marks <- 85

if(marks >= 90) {
    print("A")
} else if(marks >= 75) {
    print("B")
} else {
    print("C")
}

#for loop
for(i in 1:5){
  print(i)
}
marks <- c(10,20,30,40)
for(i in marks){
  print(i) 
}

for(i in 1:10){
  if(i %% 2 == 0){
    print(i)
  }
}

#next skips the current iteration
for(i in 1:5) {
  if(i == 3) {
    next
  }
  print(i)
}

#while loop
i<-1
while(i<=5){
  print(i)
  i<-i+1
}


